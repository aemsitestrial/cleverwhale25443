{
  "rows": {
    "titleType": {
      "readBy": "js/vendor/teaser-family.js",
      "reads": "The heading level of a Teaser-family title. A `title` field with a `titleType` field beside it arrives as one cell holding an `<h1>` to `<h5>` element, and no `titleType` row. The reader takes the level from that element's tag into the content prop `titleTag`; a cell with no heading keeps any `titleType` row it was given. The Title block takes its level as the option list `headingTag` instead (h2 when none is chosen)."
    }
  },
